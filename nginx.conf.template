events {}
http {
    access_log /dev/stdout;
    error_log /dev/stderr warn;
    resolver 1.1.1.1 8.8.8.8 valid=30s;
    map $http_upgrade $connection_upgrade { default upgrade; '' close; }
    server {
        listen __PORT__;
        server_name _;
        client_max_body_size 50m;

        location ~ ^/_auth/([^/]+)$ {
            internal;
            proxy_pass http://127.0.0.1:__API_PORT__/internal/auth/$1;
            proxy_pass_request_body off;
            proxy_set_header Content-Length "";
        }

        location ~ ^/firefox/([^/]+)(/.*)?$ {
            auth_request /_auth/$1;
            auth_request_set $backend $upstream_http_x_backend;
            auth_request_set $backend_auth $upstream_http_x_backend_auth;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $backend;
            proxy_set_header Authorization $backend_auth;
            proxy_set_header X-Forwarded-Proto https;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
            proxy_buffering off;
            proxy_ssl_server_name on;
            proxy_ssl_name $backend;
            proxy_pass https://$backend$2$is_args$args;
        }

        location / {
            proxy_pass http://127.0.0.1:__API_PORT__;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }
}
