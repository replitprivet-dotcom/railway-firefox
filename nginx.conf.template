events {}
http {
    access_log /dev/stdout;
    error_log /dev/stderr warn;
    map $http_upgrade $connection_upgrade { default upgrade; '' close; }
    server {
        listen __PORT__;
        server_name _;
        client_max_body_size 50m;

        location = /_auth/ { return 404; }
        location /_auth/ {
            internal;
            proxy_pass http://127.0.0.1:__API_PORT__/internal/auth/;
            proxy_pass_request_body off;
            proxy_set_header Content-Length "";
            proxy_set_header X-Original-URI $request_uri;
        }

        # Strip /firefox/<random-endpoint> before forwarding to LinuxServer's GUI.
        location ~ ^/firefox/([^/]+)(/.*)?$ {
            auth_request /_auth/$1;
            auth_request_set $auth_status $upstream_status;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Prefix /firefox/$1;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
            proxy_buffering off;
            proxy_pass http://127.0.0.1:3000$2$is_args$args;
        }

        location / {
            proxy_pass http://127.0.0.1:__API_PORT__;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }
}
